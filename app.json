{
  "expo": {
    "name": "CineFy",
    "slug": "cinefy",
    "scheme": "cinefy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-cinefy.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-cinefy.png",
      "resizeMode": "contain",
      "backgroundColor": "#D98A9B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.csstefany.cinefy",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-cinefy.png",
        "backgroundColor": "#D98A9B"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para você selecionar imagens.",
          "cameraPermission": "O app precisa acessar sua câmera para tirar fotos.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0f9b93a6-5990-4587-80a6-3593853f6979"
      }
    },
    "owner": "sunny_222"
  }
}
