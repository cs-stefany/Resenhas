{
  "expo": {
    "name": "CineFy",
    "slug": "cinefy",
    "scheme": "cinefy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-cinefy.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-cinefy.png",
      "resizeMode": "contain",
      "backgroundColor": "#D98A9B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-cinefy.png",
        "backgroundColor": "#D98A9B"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para você selecionar imagens.",
          "cameraPermission": "O app precisa acessar sua câmera para tirar fotos.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
